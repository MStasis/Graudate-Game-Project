; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="로컬 AI NPC 연구 시제품"
run/main_scene="res://scenes/ui/TitleMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.024, 0.03, 0.043, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/ui/bulkhead/boot_splash.png"
config/icon="res://assets/ui/bulkhead/bulkhead_mark.svg"
config/windows_native_icon="res://assets/ui/bulkhead/bulkhead_mark.ico"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=600

